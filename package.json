{
  "name": "dag-editor",
  "displayName": "DAG Editor",
  "description": "A custom document editor extension for json-formatted DAG files.",
  "repository": {
    "type": "git",
    "url": "https://github.com/QinXiaodong/DAG-Editor.git"
  },
  "publisher": "QinXiaodong",
  "icon": "assets/icon.png",
  "version": "0.4.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "dag-editor",
        "displayName": "DAG Editor",
        "selector": [
          {
            "filenamePattern": "*.dag.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "dag-editor.new",
        "title": "New DAG",
        "category": "DAG Editor"
      },
      {
        "command": "dag-editor.save",
        "title": "Save DAG",
        "category": "DAG Editor"
      }
    ],
    "keybindings": [
      {
        "command": "dag-editor.save",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == dag-editor"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node ./esbuild.js",
    "package": "node ./esbuild.js --production",
    "watch": "node ./esbuild.js --watch",
    "test": "node ./esbuild.js --test && node ./.test-out/DagModel.test.js",
    "test:integration": "npm run compile && node ./esbuild.js --integration-test && node ./.test-out/integration/runTest.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"*.{js,json,md}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{js,json,md}\" \".github/**/*.yml\"",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run compile"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@types/vscode-webview": "^1.57.0",
    "@typescript-eslint/eslint-plugin": "^5.42.0",
    "@typescript-eslint/parser": "^5.42.0",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.26.0",
    "prettier": "^2.8.1",
    "typescript": "^4.8.4"
  },
  "dependencies": {
    "@antv/g6": "5.0.6",
    "@antv/g-lite": "2.0.5",
    "jsonc-parser": "^3.3.1"
  },
  "overrides": {
    "@types/d3-dispatch": "3.0.6",
    "@antv/g": "6.0.9",
    "@antv/g-canvas": "2.0.7",
    "@antv/g-lite": "2.0.5",
    "@antv/g-plugin-dragndrop": "2.0.5",
    "@antv/component": "2.0.1",
    "@antv/event-emitter": "0.1.3",
    "@antv/graphlib": "2.0.3",
    "@antv/hierarchy": "0.6.12",
    "@antv/layout": "1.2.14-beta.4",
    "@antv/util": "3.3.7",
    "bubblesets-js": "2.3.3",
    "hull.js": "1.0.6"
  }
}
